# ───────────── TRADEOS configuration ─────────────
# Copy to .env.local for local development. Never commit real values.

# Public app URL (used for the Kite redirect URL and links)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://undmatkjencmymgmncdp.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Server-only. Required for broker sync, cron and audit logs. NEVER expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Zerodha Kite Connect — https://developers.kite.trade (server-only)
KITE_API_KEY=
KITE_API_SECRET=
# 32 random bytes, base64 — encrypts broker access tokens at rest:  openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# AI (Groq, OpenAI-compatible). Optional: without it TRADEOS uses deterministic summaries.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Scheduled sync protection (Vercel Cron sends "Authorization: Bearer $CRON_SECRET")
CRON_SECRET=

# Optional weekly email summaries via Resend
RESEND_API_KEY=
REPORT_FROM_EMAIL=
