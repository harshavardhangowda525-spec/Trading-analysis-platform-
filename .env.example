# ───────────── TRADEOS configuration ─────────────
# Copy to .env.local for local development. Never commit real values.

# Public app URL (used for the Kite redirect URL and links)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Neon Postgres (pooled connection string) — server-only
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require

# 32 random bytes, base64 — encrypts broker access tokens and TOTP secrets at rest:  openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# Zerodha Kite Connect — https://developers.kite.trade (server-only)
KITE_API_KEY=
KITE_API_SECRET=

# AI (Groq, OpenAI-compatible). Optional: without it TRADEOS uses deterministic summaries.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Scheduled sync protection ("Authorization: Bearer $CRON_SECRET")
CRON_SECRET=

# Optional weekly email summaries via Resend
RESEND_API_KEY=
REPORT_FROM_EMAIL=
